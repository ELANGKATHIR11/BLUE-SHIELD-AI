rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Disallow arbitrary writes to protected collections from clients
    match /vessels/{vesselId} {
      allow read: if true;
      allow write: if false; // Only server Firebase Admin or Postgres backend writes
    }

    match /vesselLocations/{locId} {
      allow read: if true;
      allow write: if false; // Server authoritative ingestion only
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow update: if request.auth != null; // Only authenticated users (Coast Guard) acknowledge
      allow create, delete: if false; // Server authoritative creation only
    }

    match /zones/{zoneId} {
      allow read: if true;
      allow write: if false; // Prohibited zones are server-immutable
    }

    match /auditLogs/{logId} {
      allow read: if request.auth != null && request.auth.token.role == 'COAST_GUARD';
      allow write: if false; // Immutable server-controlled logs
    }

    match /messages/{messageId} {
      // Direct messaging between fisherman and coast guard
      allow read: if true;
      allow create: if true;
      allow update: if true;
      allow delete: if false;
    }

    match /{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
