# BLUE SHIELD AI — Backend Environment Configuration

PORT=5000
NODE_ENV=production
CORS_ORIGIN=http://localhost:5173

# PostgreSQL + PostGIS (Authoritative Spatial Database)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/blueshield_db
PGHOST=localhost
PGPORT=5432
PGDATABASE=blueshield_db
PGUSER=postgres
PGPASSWORD=your_secure_db_password
PGSSL=false

# Firebase Admin Configuration (Set either JSON string, service account file path, or Project ID)
FIREBASE_PROJECT_ID=blue-shield-live-101
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
FIREBASE_STORAGE_BUCKET=blue-shield-live-101.firebasestorage.app

# Internal Python ML Microservice URL
PYTHON_ML_URL=http://127.0.0.1:5001

# Gemini Server-Side API Key (Optional Server Intelligence Explanation)
# GEMINI_API_KEY=your_gemini_server_key_here

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
